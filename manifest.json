{
  "manifest_version": 3,
  "name": "Proscom Prix - Catalogue 2026",
  "version": "2.0",
  "description": "Recherche instantanée des prix du catalogue Proscom 2026, calculateur de devis et simulateur de marge pour Cadeauette TN.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+P",
        "mac": "Command+Shift+P"
      },
      "description": "Ouvrir la recherche Proscom"
    }
  }
}